# quench.in — melt–quench of a silicate glass with the SHIK potential (Sundararaman, Huang, Ispas
# and Kob, J. Chem. Phys. 148, 194504 (2018) and 150, 154505 (2019)). Needs a LAMMPS built with the
# authors' pair style shik/wolf (github.com/compmatscirpi/SHIK-potential); see README.md here.
# Variables, passed with -var: name, nsi, nna, L (starting box edge, Å), qo (oxygen charge, set by
# charge neutrality), rate (K/ps), seed.
units           metal
atom_style      charge
boundary        p p p

region          box block 0 ${L} 0 ${L} 0 ${L}
create_box      3 box
# 1 O, 2 Si, 3 Na
variable        no equal 2*${nsi}+${nna}/2
create_atoms    2 random ${nsi} ${seed} box overlap 1.6 maxtry 200
create_atoms    1 random ${no} $(v_seed+1) box overlap 1.6 maxtry 200
create_atoms    3 random ${nna} $(v_seed+2) box overlap 1.6 maxtry 200
mass            1 15.999
mass            2 28.086
mass            3 22.990
set             type 1 charge ${qo}
set             type 2 charge 1.7755
set             type 3 charge 0.6018

pair_style      shik/wolf 8.0 10.0
#               i j  A (eV)    B (1/Å)  C (eV Å^6)  D (eV Å^24)  smoothing γ (short, Coulomb)
pair_coeff      1 1  1120.5    2.8927   26.132      16800        0.2 0.2
pair_coeff      1 2  23108     5.0979   139.70      66           0.2 0.2
pair_coeff      2 2  2798.0    4.4073   0.0         3423204      0.2 0.2
pair_coeff      1 3  1127566   6.8986   40.562      16800        0.2 0.2
pair_coeff      2 3  495653    5.4151   0.0         16800        0.2 0.2
pair_coeff      3 3  1476.9    3.4075   0.0         16800        0.2 0.2
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001
thermo          1000
thermo_style    custom step time temp pe press vol density
velocity        all create 4000 ${seed} mom yes rot yes dist gaussian

# untangle the random start, then melt hot at fixed volume and settle the liquid at zero pressure
fix             1 all nve/limit 0.05
run             5000
unfix           1
fix             1 all nvt temp 6000 6000 0.1
run             30000
unfix           1
fix             1 all npt temp 4000 4000 0.1 iso 1 1 1.0
run             40000
unfix           1

# the quench: 4000 K → 300 K at ${rate} K/ps, at one bar; every 1 ps log T, density, energy
variable        nq equal round(3700/${rate}*1000)
variable        rho equal density
fix             avg all ave/time 10 100 1000 c_thermo_temp v_rho c_thermo_pe file ${name}.cool.txt
fix             1 all npt temp 4000 300 0.1 iso 1 1 1.0
run             ${nq}
unfix           1
unfix           avg

# relax at room temperature, then keep the last frame
fix             1 all npt temp 300 300 0.1 iso 1 1 1.0
run             30000
unfix           1
write_data      ${name}.data nocoeff
