---
// Home page: the four mechanisms as the lancets of a backlit window. Each lancet's
// medallions are the real objects that mechanism explains.
import map from '../data/map.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (slug: string, anchor: string | null) => `${base}/concepts/${slug}/${anchor ? `#${anchor}` : ''}`;
const mechHref = (m: (typeof map.mechanisms)[number]) =>
  m.slugs[0] ? href(m.slugs[0], null) : href(m.anchorTarget!.targetSlug, m.anchorTarget!.anchor);
---
<section class="hero">
  <p class="label">an explorable explainer</p>
  <h1>Why is glass <em>colored?</em></h1>
  <p class="lede">
    Clear glass becomes cobalt blue, ruby red or traffic-light amber by four different kinds of
    physics. Each lancet below is one of them, and every medallion is a real object it explains.
  </p>
  <a class="start" href={href(map.anchorSlug, null)}>Start with the four mechanisms →</a>
</section>

<div class="window" role="list">
  {map.mechanisms.map((m, i) => (
    <article class="lancet" role="listitem" style={`--theme:${m.theme}`}>
      <div class="pane">
        <span class="numeral" aria-hidden="true">{['I', 'II', 'III', 'IV'][i]}</span>
        <div class="medallions">
          {m.artifacts.map((a) => (
            <a class="medallion glass" href={href(a.targetSlug, a.anchor)} style={`--glass:${a.colorCss}`} aria-label={a.label}>
              <span class="tip">{a.label}</span>
            </a>
          ))}
        </div>
      </div>
      <h2><a href={mechHref(m)}>{m.label}</a></h2>
      <p class="blurb">{m.blurb}</p>
      <ul class="objects">
        {m.artifacts.map((a) => <li><a href={href(a.targetSlug, a.anchor)}>{a.label}</a></li>)}
      </ul>
      {m.slugs.length > 1 && (
        <p class="also">also <a href={href(m.slugs[1], null)}>{m.slugs[1].replace(/-/g, ' ')}</a></p>
      )}
    </article>
  ))}
</div>

<div class="threads">
  <a class="thread" href={href(map.crosscutting.slug, null)}>
    <span class="label">cuts across all four</span>
    <span class="thread-title">Redox</span>
    <span class="thread-sub">the furnace decides which ion you get</span>
  </a>
  <a class="thread" href={href(map.craft.slug, null)}>
    <span class="label">the craft</span>
    <span class="thread-title">Stained glass</span>
    <span class="thread-sub">all four mechanisms in one window</span>
  </a>
  <a class="thread lab" href={`${base}/mixing-lab/`}>
    <span class="label">hands on</span>
    <span class="thread-title">Mixing lab</span>
    <span class="thread-sub">melt up to four colorants and watch the color respond</span>
    <span class="lab-panes" aria-hidden="true">
      <span class="glass" style="--glass:#3c5bf0"></span><span class="glass" style="--glass:#1f9a8a"></span><span class="glass" style="--glass:#e9a23b"></span>
    </span>
  </a>
</div>

<style>
  .hero { max-width: 46rem; margin: 0 auto; padding: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 4vw, 2rem) 2.5rem; text-align: center; }
  .hero h1 { font-family: var(--display); font-weight: 300; font-size: clamp(2.8rem, 9vw, 5.2rem); line-height: 1;
    letter-spacing: -0.03em; margin: 0.8rem 0 1.2rem; }
  .hero h1 em { font-style: italic; font-weight: 400;
    background: linear-gradient(100deg, #6f8dff 0%, #49c4a2 30%, #f2c14e 55%, #ef5a3c 78%, #d0457a 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.06em; }
  .lede { font-size: 1.2rem; line-height: 1.55; color: var(--muted); margin: 0 auto 1.6rem; max-width: 36rem; text-wrap: pretty; }
  .start { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em; text-decoration: none;
    display: inline-block; padding: 0.7rem 1.2rem; border-radius: 999px; border: 1px solid rgba(240,180,90,0.45);
    background: var(--accent-soft); transition: background .15s, border-color .15s; }
  .start:hover { background: rgba(240,180,90,0.24); border-color: var(--accent); }

  .window { max-width: 68rem; margin: 1rem auto 0; padding: 0 clamp(1rem, 4vw, 2rem);
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.8rem, 2vw, 1.6rem); }
  .lancet { display: flex; flex-direction: column; }
  .pane { position: relative; height: 23rem; border-radius: 50% 50% 6px 6px / 8.5rem 8.5rem 6px 6px;
    border: 5px solid #050608; outline: 1px solid rgba(255,255,255,0.08); outline-offset: 1px;
    background:
      repeating-linear-gradient(60deg, transparent 0 2.6rem, rgba(0,0,0,0.38) 2.6rem calc(2.6rem + 2px)),
      repeating-linear-gradient(-60deg, transparent 0 2.6rem, rgba(0,0,0,0.38) 2.6rem calc(2.6rem + 2px)),
      radial-gradient(120% 70% at 50% 35%, color-mix(in srgb, var(--theme) 55%, #fff 8%) 0%, color-mix(in srgb, var(--theme) 70%, #000) 70%, color-mix(in srgb, var(--theme) 30%, #000) 100%);
    box-shadow: 0 0 60px -10px color-mix(in srgb, var(--theme) 55%, transparent), inset 0 0 40px rgba(0,0,0,0.5);
    display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .numeral { position: absolute; top: 3rem; font-family: var(--display); font-size: 1.1rem; color: rgba(255,255,255,0.55); letter-spacing: 0.1em; }
  .medallions { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; margin-top: 4rem; }
  .medallion { width: 3.2rem; height: 3.2rem; border-radius: 50%; display: block;
    outline: 3px solid #050608; transition: transform .2s ease, box-shadow .2s; }
  .medallion:hover, .medallion:focus-visible { transform: scale(1.12); box-shadow: 0 0 24px 2px rgba(255,255,255,0.25); z-index: 2; }
  .tip { position: absolute; left: 50%; bottom: calc(100% + 0.5rem); transform: translateX(-50%); white-space: nowrap;
    font-family: var(--mono); font-size: 0.68rem; color: var(--text); background: #050608; border: 1px solid var(--edge-hi);
    padding: 0.25rem 0.55rem; border-radius: 6px; opacity: 0; pointer-events: none; transition: opacity .15s; }
  .medallion:hover .tip, .medallion:focus-visible .tip { opacity: 1; }

  .lancet h2 { font-family: var(--display); font-weight: 400; font-size: 1.45rem; line-height: 1.15; margin: 1.2rem 0 0.4rem; }
  .lancet h2 a { color: var(--text); text-decoration: none; }
  .lancet h2 a:hover { color: color-mix(in srgb, var(--theme) 60%, #fff); }
  .blurb { font-size: 0.95rem; line-height: 1.5; color: var(--muted); margin: 0 0 0.6rem; }
  .objects { list-style: none; padding: 0; margin: 0; font-size: 0.88rem; }
  .objects li { padding: 0.2rem 0; border-top: 1px solid var(--edge); }
  .objects a { color: var(--text); text-decoration: none; opacity: 0.85; }
  .objects a:hover { color: var(--accent); opacity: 1; }
  .also { font-family: var(--mono); font-size: 0.7rem; color: var(--faint); margin: 0.6rem 0 0; letter-spacing: 0.04em; }

  .threads { max-width: 68rem; margin: 3.5rem auto 0; padding: 0 clamp(1rem, 4vw, 2rem);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .thread { position: relative; display: flex; flex-direction: column; gap: 0.25rem; padding: 1.2rem 1.3rem 1.3rem;
    border-radius: 14px; border: 1px solid var(--edge); background: linear-gradient(180deg, var(--bg-raise), var(--panel));
    text-decoration: none; color: var(--text); transition: border-color .2s, transform .2s; overflow: hidden; }
  .thread:hover { border-color: rgba(240,180,90,0.4); transform: translateY(-2px); }
  .thread-title { font-family: var(--display); font-size: 1.45rem; line-height: 1.2; }
  .thread-sub { font-size: 0.95rem; color: var(--muted); }
  .lab-panes { position: absolute; right: 1.1rem; top: 1.1rem; display: flex; }
  .lab-panes .glass { width: 1.3rem; height: 1.8rem; border-radius: 3px; margin-left: -0.35rem; }

  @media (max-width: 900px) {
    .window { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .threads { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .pane { height: 16rem; border-radius: 50% 50% 6px 6px / 5rem 5rem 6px 6px; }
    .medallions { gap: 0.5rem; margin-top: 2.6rem; }
    .medallion { width: 2.4rem; height: 2.4rem; }
    .numeral { top: 1.8rem; font-size: 0.9rem; }
    .lancet h2 { font-size: 1.2rem; }
  }
</style>
