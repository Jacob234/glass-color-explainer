---
// "Where am I" strip: highlights the current page's mechanism, links the others.
import map from '../data/map.json';
const { slug, mechanism } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nodes = [
  ...map.mechanisms.map((m) => ({
    id: m.id,
    label: m.label,
    href: m.slugs[0]
      ? `${base}/concepts/${m.slugs[0]}/`
      : `${base}/concepts/${m.anchorTarget.targetSlug}/#${m.anchorTarget.anchor}`,
  })),
  { id: 'crosscutting', label: 'redox', href: `${base}/concepts/${map.crosscutting.slug}/` },
  { id: 'craft', label: 'the craft', href: `${base}/concepts/${map.craft.slug}/` },
];
---
<nav class="locator" aria-label="mechanism locator">
  {nodes.map((n) => (
    <a href={n.href} class={`locator-node${n.id === mechanism ? ' active' : ''}`} aria-current={n.id === mechanism ? 'true' : undefined}>{n.label}</a>
  ))}
</nav>
<style>
  .locator { display: flex; gap: 0.3rem 1.1rem; flex-wrap: wrap; font-family: var(--mono); font-size: 0.7rem;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 0.4rem 0; }
  .locator a { color: var(--faint); text-decoration: none; padding: 0.2rem 0; border-bottom: 1px solid transparent;
    transition: color .15s, border-color .15s; }
  .locator a:hover { color: var(--text); }
  .locator a.active { color: var(--theme, var(--accent)); border-bottom-color: currentColor; }
</style>
