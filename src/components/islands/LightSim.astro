---
import { LAMPS } from '../../scripts/lamps.js';
import optics from '../../data/optics.json';
const lamps = LAMPS.filter((l) => !l.dark);
---
<figure class="ls">
  <canvas aria-label="A beam of light crossing a darkened table and passing through glass"></canvas>
  <div class="ls-controls">
    <label>scene <select name="preset"><option value="prism">prism</option><option value="lens">lens</option><option value="slab">slab</option></select></label>
    <label>glass <select name="glass"></select></label>
    <label>colorant <select name="colorant"><option value="clear">none (clear)</option>{optics.colorants.map((c) => <option value={c.id}>{c.label}</option>)}</select></label>
    <label>lamp <select name="lamp">{lamps.map((l) => <option value={l.id}>{l.label}</option>)}</select></label>
    <label>amount <input type="range" name="conc" min="0" max="100" value="40" /></label>
    <label>turn <input type="range" name="rot" min="-180" max="180" value="0" /></label>
  </div>
  <p class="island-footnote"><span class="ls-count mono"></span> Drag the glass. A model: light in one plane, each ray one wavelength, Fresnel reflection averaged over polarisation, refractive index from SCHOTT Sellmeier fits (Zemax catalogue 2017-01-20b, via refractiveindex.info), absorption from the page's illustrative colorant spectra.</p>
</figure>
<script>
  import { initLightSim } from '../../scripts/islands/lightsim.js';
  for (const el of document.querySelectorAll('.ls')) initLightSim(el);
</script>
<style>
  .ls { margin: 1.5rem 0; }
  .ls canvas { display: block; width: 100%; aspect-ratio: 180 / 110; border-radius: 4px; touch-action: none; cursor: grab; background: #333; }
  .ls-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.4rem 1rem; margin-top: 0.8rem; font-size: 0.8rem; color: var(--muted); }
  .ls-controls label { display: flex; flex-direction: column; }
  .ls-controls select { font: inherit; color: var(--ink); background: var(--paper); border: 1px solid var(--edge); padding: 0.25rem; }
  .island-footnote { font-size: 0.72rem; color: var(--faint); margin: 0.5rem 0 0; }
</style>
