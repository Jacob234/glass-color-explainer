---
// Hero instrument: a gather on the blowpipe, cooling from furnace heat to room temperature.
import optics from '../../data/optics.json';
import { mixedAbsorbance, transmittedColor } from '../../scripts/optics-core.js';

const daylight = optics.illuminants.find((i) => i.id === 'daylight')!;
const choices = [
  { id: 'cobalt', label: 'cobalt', why: 'Room temperature: cobalt blue. Co²⁺ absorbs the orange and red, so only blue gets through.' },
  { id: 'copper', label: 'copper', why: 'Room temperature: turquoise. Cu²⁺ absorbs the red end of the spectrum.' },
  { id: 'chromium', label: 'chromium', why: 'Room temperature: green. Cr³⁺ absorbs violet and red, leaving a green window.' },
  { id: 'manganese', label: 'manganese', why: 'Room temperature: amethyst. Mn³⁺ absorbs in the green, so red and blue get through.' },
].map((c) => {
  const colorant = optics.colorants.find((x) => x.id === c.id)!;
  // a gather is thicker than the reference sample
  const curve = mixedAbsorbance([{ colorant, c: 1 }], optics.wavelengths.length, 1.2);
  return { ...c, color: transmittedColor(optics.wavelengths, curve, daylight.spd) };
});
---
<figure class="gather">
  <svg class="g-scene" viewBox="0 0 900 320" role="img" aria-label="a gather of glass on a blowpipe being pulled from the glory hole of a furnace">
    <defs>
      <radialGradient id="g-hole" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fff8e2"/><stop offset="0.45" stop-color="#ffc35a"/>
        <stop offset="0.78" stop-color="#ff6a1a"/><stop offset="1" stop-color="#5a1404"/>
      </radialGradient>
      <linearGradient id="g-pipe" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#d9d6d0"/><stop offset="0.45" stop-color="#6b6862"/><stop offset="1" stop-color="#2a2826"/>
      </linearGradient>
      <radialGradient id="g-shine" cx="0.32" cy="0.28" r="0.6">
        <stop offset="0" stop-color="#fff" stop-opacity="0.75"/><stop offset="0.35" stop-color="#fff" stop-opacity="0.12"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="g-rim" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0.6" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity="0.45"/>
      </radialGradient>
      <filter id="g-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="18"/></filter>
      <filter id="g-blur-s" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="8"/></filter>
    </defs>

    <!-- shop floor -->
    <rect x="0" y="286" width="900" height="34" fill="#0d0b0a"/>
    <line x1="0" y1="286" x2="900" y2="286" stroke="rgba(255,190,120,0.12)"/>

    <!-- furnace: firebrick face with the glory hole -->
    <g class="g-furnace">
      <rect x="668" y="20" width="250" height="266" rx="10" fill="#2a1d18"/>
      <g stroke="#1a110e" stroke-width="3">
        <line x1="668" y1="70" x2="918" y2="70"/><line x1="668" y1="120" x2="918" y2="120"/>
        <line x1="668" y1="200" x2="918" y2="200"/><line x1="668" y1="250" x2="918" y2="250"/>
        <line x1="720" y1="20" x2="720" y2="70"/><line x1="820" y1="20" x2="820" y2="70"/>
        <line x1="770" y1="200" x2="770" y2="250"/><line x1="870" y1="200" x2="870" y2="250"/>
      </g>
      <circle cx="790" cy="160" r="128" fill="#ff7a24" opacity="0.25" filter="url(#g-blur)"/>
      <circle cx="790" cy="160" r="84" fill="#120b08" stroke="#3d2a22" stroke-width="10"/>
      <circle class="g-hole" cx="790" cy="160" r="76" fill="url(#g-hole)"/>
    </g>

    <!-- pipe and gather: slide left as they cool -->
    <g class="g-rig">
      <ellipse cx="790" cy="292" rx="90" ry="10" class="g-cast" filter="url(#g-blur-s)"/>
      <circle cx="790" cy="160" r="96" class="g-halo" filter="url(#g-blur)"/>
      <rect x="-420" y="154" width="1170" height="12" rx="3" fill="url(#g-pipe)"/>
      <rect x="-420" y="150" width="60" height="20" rx="4" fill="#3a3632"/>
      <path class="g-body" d="M736 156 C 736 112, 772 104, 800 106 C 842 108, 856 138, 856 162 C 856 192, 832 214, 796 214 C 760 214, 736 196, 736 156 Z"/>
      <path d="M736 156 C 736 112, 772 104, 800 106 C 842 108, 856 138, 856 162 C 856 192, 832 214, 796 214 C 760 214, 736 196, 736 156 Z" fill="url(#g-rim)" class="g-rimshade"/>
      <path class="g-spin" d="M736 156 C 736 112, 772 104, 800 106 C 842 108, 856 138, 856 162 C 856 192, 832 214, 796 214 C 760 214, 736 196, 736 156 Z" fill="url(#g-shine)"/>
    </g>
  </svg>

  <div class="g-panel">
    <div class="g-row">
      <span class="g-readout" aria-live="off">1150 °C</span>
      <div class="g-colorants pills" role="group" aria-label="colorant in the gather">
        {choices.map((c) => (
          <button class="pill" data-color={c.color} data-why={c.why}>
            <span class="g-dot" style={`background:${c.color}`}></span>{c.label}
          </button>
        ))}
      </div>
    </div>
    <input class="g-temp" type="range" min="20" max="1150" step="1" value="1150" aria-label="gather temperature" />
    <div class="g-ticks" aria-hidden="true">
      {[[20, 'room'], [525, 'glow fades'], [900, 'working'], [1150, 'furnace']].map(([t, name]) => (
        <span style={`--at:${((Number(t) - 20) / 1130) * 100}%`}><b>{t} °C</b>{name}</span>
      ))}
    </div>
    <p class="g-stage" aria-live="polite"></p>
  </div>
</figure>
<script>
  import { initGather } from '../../scripts/islands/gather.js';
  for (const el of document.querySelectorAll('.gather')) initGather(el);
</script>
<style>
  .gather { margin: 0; --gather: #ff9a3a; --glow: 1; --glow-rgb: #ff6400; }
  .g-scene { display: block; width: 100%; height: auto; overflow: visible; }
  .g-rig { transition: transform 0.08s linear; }
  .g-body { fill: var(--gather); }
  /* hot glass glows from within, so the dark rim only appears as it cools */
  .g-rimshade { opacity: calc(1 - var(--glow) * 0.9); }
  .g-halo { fill: var(--glow-rgb); opacity: calc(var(--glow) * 0.85); }
  .g-cast { fill: var(--gather); opacity: calc(0.25 + var(--glow) * 0.4); }
  .g-hole { animation: flicker 3.2s ease-in-out infinite; }
  .g-spin { transform-box: fill-box; transform-origin: 50% 50%; animation: turn 2.4s ease-in-out infinite alternate; }
  @keyframes flicker { 0%, 100% { opacity: 1; } 40% { opacity: 0.9; } 55% { opacity: 0.97; } }
  @keyframes turn { from { transform: translateY(-2px) scaleX(0.96); } to { transform: translateY(2px) scaleX(1.03); } }

  .g-panel { max-width: 44rem; margin: 0.4rem auto 0; padding: 0 1rem; }
  .g-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .g-readout { font-family: var(--mono); font-size: 1.6rem; color: var(--accent); font-variant-numeric: tabular-nums; min-width: 6.5ch; }
  .g-dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1px solid rgba(255,255,255,0.25); }
  .g-temp { width: 100%; margin-top: 0.8rem; }
  .g-ticks { position: relative; height: 2.2rem; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.04em; color: var(--faint); }
  .g-ticks span { position: absolute; left: var(--at); transform: translateX(-50%); text-align: center; white-space: nowrap; padding-top: 0.35rem; }
  .g-ticks span::before { content: ""; position: absolute; top: 0; left: 50%; height: 0.25rem; border-left: 1px solid var(--faint); }
  .g-ticks span:first-child { transform: none; text-align: left; } .g-ticks span:first-child::before { left: 0.4rem; }
  .g-ticks span:last-child { transform: translateX(-100%); text-align: right; } .g-ticks span:last-child::before { left: auto; right: 0.4rem; }
  .g-ticks b { display: block; font-weight: 500; color: var(--muted); }
  .g-stage { font-size: 1.08rem; color: var(--text); margin: 0.9rem 0 0; min-height: 3.2em; text-wrap: pretty; }
  @media (max-width: 640px) {
    .g-ticks span:nth-child(3) { display: none; }
    .g-readout { font-size: 1.3rem; }
  }
</style>
