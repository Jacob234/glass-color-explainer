---
// props: colorants — comma-separated colorant ids (empty = all)
// Note: the SVG gradient uses id="vis". If two SpectrumExplorer instances ever
// appeared on the same page they would collide; in this site each concept page
// gets at most one instance, so this is acceptable.
import optics from '../../data/optics.json';
const { colorants = '' } = Astro.props;
const ids = colorants ? colorants.split(',').filter(Boolean) : [];
const selected = optics.colorants.filter((c) => (ids.length ? ids.includes(c.id) : true));
---
<figure class="spx instrument" data-colorants={colorants}>
  <p class="lab-label">absorption over the visible spectrum</p>
  <div class="spx-buttons pills">
    {selected.map((c) => <button class="pill" data-id={c.id}>{c.label}</button>)}
  </div>
  <div class="spx-stage">
    <svg viewBox="0 0 360 90" class="spx-svg spectrum-frame" role="img" aria-label="absorption curve over the visible spectrum" preserveAspectRatio="none">
      <defs>
        <linearGradient id="vis" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="#610061"/><stop offset="12%" stop-color="#3b00b8"/>
          <stop offset="28%" stop-color="#007bff"/><stop offset="44%" stop-color="#00c853"/>
          <stop offset="58%" stop-color="#ffe600"/><stop offset="74%" stop-color="#ff8c00"/>
          <stop offset="100%" stop-color="#c40000"/>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="360" height="90" fill="url(#vis)"/>
      <polygon class="spx-shade" fill="#06070a" fill-opacity="0.82" points=""/>
      <polyline class="spx-curve" fill="none" stroke="#fff" stroke-opacity="0.9" stroke-width="1.5" vector-effect="non-scaling-stroke" points=""/>
    </svg>
    <div class="spx-swatch swatch-pane glass cast" title="transmitted color"></div>
  </div>
  <div class="axis" aria-hidden="true"><span>380 nm</span><span>violet · blue · green · yellow · red</span><span>780 nm</span></div>
  <figcaption><span class="spx-why"></span></figcaption>
  <p class="island-footnote">Shaded: the light the glass absorbs. What is left above the curve reaches your eye, and the pane shows that remainder as a color. Curves are illustrative approximations, not measured spectra; the color is integrated against the CIE 1931 observer under daylight.</p>
</figure>
<script>
  import optics from '../../data/optics.json';
  import { initSpectrumExplorer } from '../../scripts/islands/spectrum.js';
  for (const el of document.querySelectorAll('.spx')) initSpectrumExplorer(el, optics);
</script>
<style>
  .spx-buttons { margin: 0.4rem 0 1rem; }
  .spx-stage { display: flex; gap: 1.2rem; align-items: center; }
  .spx-svg { flex: 1; height: 7rem; }
  .axis { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 0.62rem; color: var(--faint);
    letter-spacing: 0.06em; margin-top: 0.35rem; padding-right: 5.6rem; }
  @media (max-width: 640px) { .axis { padding-right: 4.6rem; } .axis span:nth-child(2) { display: none; } }
</style>
