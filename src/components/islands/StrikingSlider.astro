---
// props: sequence — "gold" | "selenium"
const { sequence } = Astro.props;
---
<figure class="stk instrument" data-sequence={sequence}>
  <p class="lab-label">striking: reheat the glass and the color develops</p>
  <div class="stk-row">
    <div class="stk-swatch swatch-pane glass cast"></div>
    <div class="stk-controls">
      <input type="range" min="0" max="100" value="0" aria-label="heat treatment, time times temperature" />
      <div class="stk-scale" aria-hidden="true"><span>as cast</span><span>heat treatment →</span><span>over-struck</span></div>
      <p class="stk-label"></p>
    </div>
  </div>
  <p class="island-footnote">A stylized striking timeline. Real schedules are composition-specific, and the over-struck endpoint is the failure mode, not a destination.</p>
</figure>
<script>
  import optics from '../../data/optics.json';
  import { initStrikingSlider } from '../../scripts/islands/striking.js';
  for (const el of document.querySelectorAll('.stk')) initStrikingSlider(el, optics);
</script>
<style>
  .stk-row { display: flex; gap: 1.4rem; align-items: center; margin-top: 0.6rem; }
  .stk-controls { flex: 1; }
  .stk-controls input { width: 100%; }
  .stk-scale { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.06em; color: var(--faint); }
  .stk-label { font-family: var(--display); font-size: 1.15rem; color: var(--text); margin: 0.6rem 0 0; min-height: 1.5em; }
</style>
