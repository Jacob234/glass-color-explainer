---
// The atlas: the same lessons laid out by physics strand (rows) against studio step (columns).
// Within a strand, lessons run foundation first: by how deep they sit in the builds-on graph, then
// in walk order. Empty cells are what the site does not explain yet.
import Base from '../layouts/Base.astro';
import { LESSONS, STEPS, STRANDS, byId, chapterHref, type Lesson } from '../lib/lessons';
import { CONCEPTS, DOMAINS, conceptById, lessonsOf, labHref } from '../lib/concepts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const depthMemo: Record<string, number> = {};
const depth = (l: Lesson): number => (depthMemo[l.id] ??= l.buildsOn.length ? 1 + Math.max(...l.buildsOn.map((id) => depth(byId[id]))) : 0);
const walkOrder = (l: Lesson) => LESSONS.indexOf(l);
const foundationFirst = (a: Lesson, b: Lesson) => depth(a) - depth(b) || walkOrder(a) - walkOrder(b);
const cell = (strand: string, step: string) => LESSONS.filter((l) => l.step === step && l.strands.includes(strand));
const labLabel = Object.fromEntries(LESSONS.flatMap((l) => l.labs)) as Record<string, string>;
const onSite = CONCEPTS.filter((c) => c.coverage !== 'none').length;
const filled = STRANDS.reduce((n, s) => n + STEPS.filter((st) => cell(s.id, st.id).length).length, 0);
---
<Base title="Atlas" description="How Glass Works by physics: every lesson placed by its physics strand and its studio step, so you can read all of absorption, or everything that happens in the lehr.">
  <main class="wrap atlas">
    <p class="detail-type">Atlas</p>
    <h1>The same glass, <i>by physics</i></h1>
    <p class="summary">
      The walk follows the studio. This page follows the physics. Rows are strands, columns are studio steps, and each lesson sits
      in every strand it teaches. Read along a row to meet one idea in every place the studio uses it. Read down a column to see
      everything one step depends on. {filled} of {STRANDS.length * STEPS.length} cells hold a lesson; the empty ones are what the site does not explain yet.
    </p>

    <div class="grid-wrap" role="region" aria-label="strands against studio steps" tabindex="0">
      <table class="grid">
        <thead>
          <tr><th></th>{STEPS.map((s) => <th scope="col"><a href={`#step-${s.id}`}>{s.label}</a></th>)}</tr>
        </thead>
        <tbody>
          {STRANDS.map((strand) => (
            <tr>
              <th scope="row"><a href={`#strand-${strand.id}`}>{strand.label}</a></th>
              {STEPS.map((step) => {
                const ls = cell(strand.id, step.id);
                return <td class:list={{ empty: !ls.length }}>{ls.map((l) => <a href={chapterHref(l)} class:list={{ ch: l.chapter }} title={l.title}>{l.num}</a>)}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="key mono">numbers are stages · boxed: has a chapter page · empty cell: not explained yet</p>

    <h2>By <i>strand</i></h2>
    <p class="lede">Foundation first: a lesson comes after the ones it builds on.</p>
    <div class="lists">
      {STRANDS.map((strand) => (
        <section id={`strand-${strand.id}`}>
          <h3>{strand.label}</h3>
          <p class="blurb">{strand.blurb}</p>
          <ol>
            {LESSONS.filter((l) => l.strands.includes(strand.id)).sort(foundationFirst).map((l) => (
              <li><a href={chapterHref(l)}><span class="mono">{l.num}</span> {l.title}</a></li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <h2>By <i>studio step</i></h2>
    <p class="lede">The walk's own order. <a href={`${base}/#glass`}>Read it as one page</a> or <a href={`${base}/chapters/`}>as chapters</a>.</p>
    <div class="lists">
      {STEPS.map((step) => (
        <section id={`step-${step.id}`}>
          <h3>{step.label}</h3>
          <ol>
            {LESSONS.filter((l) => l.step === step.id).map((l) => (
              <li><a href={chapterHref(l)}><span class="mono">{l.num}</span> {l.title}</a></li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <h2>By <i>concept</i></h2>
    <p class="lede">
      The whole subject as a graph of {CONCEPTS.length} concepts in {DOMAINS.length} domains. Each lists what you need first and
      where the site teaches it; {onSite} are on the site in some form, and the rest are not written yet. The prerequisites and coverage are editorial judgments, not measurements. Concepts marked
      <span class="mono">threshold</span> change how the rest is understood.
    </p>
    <div class="domains">
      {DOMAINS.map((d) => (
        <section id={`domain-${d.id}`}>
          <h3>{d.id} · {d.label}</h3>
          <p class="blurb">{d.blurb}</p>
          <ol class="concepts">
            {CONCEPTS.filter((c) => c.domain === d.id).map((c) => (
              <li id={`concept-${c.id}`} class:list={['cg-row', c.coverage]}>
                <span class="mono cid">{c.id}</span>
                <span class="cname">{c.name}{c.threshold && <span class="mono thr"> threshold</span>}</span>
                <span class="where">
                  {lessonsOf(c).map((l) => <a href={chapterHref(l)} title={l.title}>{l.num}</a>)}
                  {(c.labs ?? []).map((slug) => <a href={labHref(slug)}>{labLabel[slug] ?? slug}</a>)}
                  {c.also && <span class="also">{c.also}</span>}
                  {c.coverage === 'none' && <span class="also">not on the site yet</span>}
                </span>
                {c.requires.length > 0 && (
                  <span class="req"><span class="mono">needs</span> {c.requires.map((id) => <a href={`#concept-${id}`} title={conceptById[id].name}>{id}</a>)}</span>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</Base>
<style>
  .atlas { padding-top: 2rem; padding-bottom: 5rem; }
  .atlas h1 { font-family: var(--display); font-weight: 500; font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.05; margin: 0.4rem 0 0; text-wrap: balance; }
  .atlas h2 { font-family: var(--display); font-weight: 500; font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 3.2rem 0 0; }
  .summary, .lede { max-width: 46rem; margin-top: 1rem; }
  .grid-wrap { overflow-x: auto; margin-top: 2rem; }
  .grid { border-collapse: collapse; min-width: 44rem; width: 100%; }
  .grid th, .grid td { border: 1px solid var(--rule); padding: 0.4rem 0.45rem; vertical-align: top; }
  .grid thead th { font-family: var(--mono); font-weight: 400; font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; text-align: left; border-bottom: 1px solid var(--ink); }
  .grid tbody th { font-family: var(--mono); font-weight: 400; font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; text-align: left; white-space: nowrap; }
  .grid th a { color: var(--ink-2); text-decoration: none; }
  .grid td { height: 2.6rem; }
  .grid td a { display: inline-block; font-family: var(--mono); font-size: 0.8rem; margin: 0 0.3rem 0.2rem 0; text-decoration: none; padding: 0 0.25rem; }
  .grid td a:hover { background: var(--paper-2); }
  .grid td a.ch { outline: 1.5px solid var(--ink); }
  .grid td.empty { background: repeating-linear-gradient(135deg, transparent 0 6px, var(--paper-2) 6px 7px); }
  .key { margin-top: 0.6rem; }
  .lists { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 1.6rem 2rem; margin-top: 1.4rem; }
  .lists section { min-width: 0; border-top: 1px solid var(--ink); padding-top: 0.6rem; scroll-margin-top: 1rem; }
  .lists h3 { font-family: var(--mono); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0; }
  .blurb { font-size: 0.85rem; color: var(--ink-2); margin: 0.3rem 0 0; }
  .lists ol { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.3rem; }
  .lists li a { text-decoration: none; font-family: var(--display); font-size: 1.05rem; line-height: 1.25; }
  .lists li a:hover { text-decoration: underline; }
  .lists li .mono { margin-right: 0.3rem; }
  .domains { display: grid; gap: 2rem; margin-top: 1.4rem; }
  .domains section { border-top: 1px solid var(--ink); padding-top: 0.6rem; scroll-margin-top: 1rem; }
  .domains h3 { font-family: var(--mono); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0; }
  .concepts { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.15rem; }
  .cg-row { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr) auto; gap: 0.1rem 0.8rem; align-items: baseline; padding: 0.35rem 0; border-bottom: 1px solid var(--rule); scroll-margin-top: 1rem; }
  .cg-row:target { background: var(--paper-2); }
  .cid { color: var(--ink-3); }
  .cname { font-family: var(--display); font-size: 1.02rem; line-height: 1.25; }
  .cg-row.none .cname { color: var(--ink-3); }
  .thr { font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .where { display: flex; flex-wrap: wrap; gap: 0.2rem 0.5rem; justify-content: flex-end; font-size: 0.8rem; }
  .where a { font-family: var(--mono); text-decoration: none; border: 1px solid var(--rule); padding: 0 0.3rem; }
  .where a:hover { background: var(--paper-2); }
  .also { color: var(--ink-3); font-size: 0.78rem; }
  .req { grid-column: 2 / -1; font-size: 0.78rem; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 0.15rem 0.4rem; align-items: baseline; }
  .req a { font-family: var(--mono); color: var(--ink-2); }
  @media (max-width: 560px) { .cg-row { grid-template-columns: 2.2rem minmax(0, 1fr); } .where { grid-column: 2; justify-content: flex-start; } }
</style>
